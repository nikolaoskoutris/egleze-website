{
  "rewrites": [
    {
      "source": "/topic/:slug",
      "destination": "/topic/:slug.html"
    },
    {
      "source": "/topic/:slug/",
      "destination": "/topic/:slug.html"
    },
    {
      "source": "/story/:slug",
      "destination": "/story/:slug.html"
    },
    {
      "source": "/story/:slug/",
      "destination": "/story/:slug.html"
    }
  ],
  "redirects": [
    {
      "source": "/topic/intelligence",
      "destination": "/topic/espionage",
      "permanent": true
    },
    {
      "source": "/topic/finance",
      "destination": "/topic/money",
      "permanent": true
    },
    {
      "source": "/topic/business",
      "destination": "/topic/money",
      "permanent": true
    },
    {
      "source": "/topic/ai",
      "destination": "/topic/ai-tech",
      "permanent": true
    },
    {
      "source": "/topic/health",
      "destination": "/topic/health-longevity-biohacking",
      "permanent": true
    },
    {
      "source": "/topic/ufo",
      "destination": "/topic/ufo-paranormal",
      "permanent": true
    },
    {
      "source": "/topic/faith",
      "destination": "/topic/faith-spirituality",
      "permanent": true
    },
    {
      "source": "/topic/consciousness",
      "destination": "/topic/consciousness-medicine",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/topic/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=600"
        }
      ]
    },
    {
      "source": "/story/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, s-maxage=3600"
        }
      ]
    }
  ]
}
